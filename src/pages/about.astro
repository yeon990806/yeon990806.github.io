<script>
  const REDUCE = () => window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- 타임라인 레일: 스크롤 진행도를 --p 로 반영 ---- */
  let rafPending = false;
  function paintRail() {
    rafPending = false;
    const el = document.querySelector<HTMLElement>('[data-timeline]');
    if (!el) return;
    if (REDUCE()) {
      el.style.setProperty('--p', '1');
      return;
    }
    const r = el.getBoundingClientRect();
    const anchor = window.innerHeight * 0.6;
    const p = Math.min(1, Math.max(0, (anchor - r.top) / Math.max(r.height, 1)));
    el.style.setProperty('--p', p.toFixed(4));
  }
  function requestRail() {
    if (rafPending) return;
    rafPending = true;
    requestAnimationFrame(paintRail);
  }

  /* ---- 숫자 카운트업 ---- */
  function setupCounters() {
    const nodes = document.querySelectorAll<HTMLElement>('[data-count]:not([data-counted])');
    if (nodes.length === 0) return;

    const run = (el: HTMLElement) => {
      el.dataset.counted = 'true';
      const target = Number(el.dataset.count || '0');
      if (REDUCE() || target <= 0) {
        el.textContent = String(target);
        return;
      }
      const duration = 900;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        el.textContent = String(Math.round(target * eased));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };

    const io = new IntersectionObserver(
      (entries, obs) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          obs.unobserve(e.target);
          run(e.target as HTMLElement);
        }
      },
      { threshold: 0.4 },
    );
    nodes.forEach((n) => io.observe(n));
  }

  /* ---- 섹션 스크롤스파이 ---- */
  let spyObserver: IntersectionObserver | null = null;
  function setupSpy() {
    spyObserver?.disconnect();
    const sections = document.querySelectorAll<HTMLElement>('[data-spy]');
    if (sections.length === 0) return;

    const links = new Map<string, HTMLElement>();
    document.querySelectorAll<HTMLElement>('[data-spy-link]').forEach((a) => {
      links.set(a.dataset.spyLink!, a);
    });

    const visible = new Set<string>();
    spyObserver = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        }
        // 문서 순서상 가장 위에 걸린 섹션을 활성으로.
        let active: string | null = null;
        for (const s of sections) {
          if (visible.has(s.id)) {
            active = s.id;
            break;
          }
        }
        links.forEach((a, id) => a.classList.toggle('is-active', id === active));
      },
      { rootMargin: '-45% 0px -45% 0px' },
    );
    sections.forEach((s) => spyObserver!.observe(s));
  }

  function setupAbout() {
    if (!document.querySelector('[data-about]')) return;
    setupCounters();
    setupSpy();
    paintRail();
  }

  window.addEventListener('scroll', requestRail, { passive: true });
  window.addEventListener('resize', requestRail, { passive: true });

  setupAbout();
  document.addEventListener('astro:page-load', setupAbout);
</script>
