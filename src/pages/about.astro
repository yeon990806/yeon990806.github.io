---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { SOCIAL_LINKS } from '../consts';

/* ============================================================
   ABOUT 페이지 데이터.
   여기만 편집하면 페이지가 자동으로 새로 그려집니다.
   bio·now는 배열 (한 원소 = 한 문단), 빈 배열은 섹션 자동 숨김.
   career.period 는 `YYYY.MM - YYYY.MM` 또는 `YYYY.MM - 현재` 형식.
   ============================================================ */
const ABOUT = {
  name: '김도연',
  handle: 'yeon',

  tagline:
    '웹과 앱, 솔루션을 만드는 풀스택 개발자.',

  location: '대한민국',

  bio: [
    '안녕하세요, **김도연** (yeon) 입니다.',
    '투네이션에서 대규모 트래픽 환경의 프론트엔드와 서비스 개발을 담당했고, CI/CD 파이프라인을 직접 구축해 운영했습니다. 최근 1년 6개월은 하울링에서 전자 계약 · 근태 관리 · 3PL WMS/OMS 솔루션을 Web과 Flutter 기반 모바일까지 동시에 만들면서, 웹과 모바일을 아우르는 풀스택으로 영역을 넓혔습니다.',
    '요즘은 **AX(AI Experience)** 에 대한 고민과 함께, 프로덕트 디자이너의 관점에서 서비스를 다루는 방향도 같이 공부하고 있습니다.',
  ],

  career: [
    {
      period: '2025.01 - 2026.06',
      role: '(주)하울링 · 개발팀 엔지니어',
      summary: '전자 계약과 근태, 물류까지 세 개의 솔루션을 Web과 Flutter로 동시에 만들었습니다.',
      stack: ['Next.js', 'React', 'Flutter', 'TypeScript'],
      highlights: [
        '일용직 근로자 특화 전자 계약 서비스 — <code>WINK</code>',
        '근태 관리 통합 플랫폼 (Web · Flutter) — <code>WINK WORKER</code>',
        '3PL WMS · OMS 통합 솔루션 — <code>DOODA</code>',
      ],
      ongoing: [
        '전자계약 v1 · v2 병존 운영과 폐기 일정 조율',
        'EC2 수동 배포 운영 및 릴리스 반영',
        'Sentry 기반 오류 모니터링',
        '앱 강제 업데이트 · 토큰 자동 재발급 대응',
      ],
    },
    {
      period: '2021.02 - 2024.12',
      role: '(주)투네이션 · 개발본부 Staff',
      summary: '대규모 트래픽을 받는 방송 후원 플랫폼의 프론트엔드와 정산 시스템을 맡았습니다.',
      stack: ['Vue.js', 'React', 'TypeScript', 'Flutter', 'CI/CD'],
      highlights: [
        'Flutter PoC 리모컨 현대화',
        '치지직(Chzzk) · 투네AD 클라이언트 리모컨',
        '투네이션 Play Web 2차 고도화',
        'HTML5 Custom Elements 관리자 UI Kit',
        '글로벌 다국어 언어팩 인프라',
        '정산 시스템 대규모 개편',
        '가챠온(Gachaon) · 퀴즈킹(QuizKing)',
      ],
      ongoing: [
        '각종 이벤트 페이지 제작 및 운영',
        '후원 기능 업데이트',
        '크고 작은 QA 이슈 대응',
      ],
    },
  ],

  skills: {
    primary: [
      'TypeScript',
      'React',
      'Next.js',
      'Vue.js',
      'Flutter',
      'HTML / CSS',
    ],
    side: [
      'Zustand',
      'Astro',
      'Node.js',
      'Firebase',
      'RESTful API',
      'CI/CD',
      'Figma',
    ],
  },

  certs: {
    have: [
      '정보처리기능사',
      'OCJP (Oracle Certified Java Programmer)',
      '웹디자인기능사',
    ],
    pursuing: [],
    education: [
      '단국대학교 · 산업경영 학사 (2023 - 재학 중)',
      '양영디지털고등학교 (2015 - 2018)',
    ],
  },

  now: [],
};

/* ---------- 파생값 (데이터에서 계산, 하드코딩하지 않음) ---------- */

/** `2021.02` → {y, m}. `현재`는 오늘 날짜. */
function parseMonth(token: string): { y: number; m: number } {
  const t = token.trim();
  if (t === '현재' || t.toLowerCase() === 'present') {
    const now = new Date();
    return { y: now.getFullYear(), m: now.getMonth() + 1 };
  }
  const [y, m] = t.split('.').map(Number);
  return { y, m: m || 1 };
}

function diffMonths(a: { y: number; m: number }, b: { y: number; m: number }): number {
  return (b.y - a.y) * 12 + (b.m - a.m);
}

/** 기간 문자열의 개월 수. 국내 이력서 관행대로 시작·종료 월을 모두 포함합니다. */
function monthsOf(period: string): number {
  const [from, to] = period.split('-');
  if (!to) return 0;
  return Math.max(0, diffMonths(parseMonth(from), parseMonth(to)) + 1);
}

/** `18` → `1년 6개월`. 0인 단위는 생략. */
function humanizeMonths(months: number): string {
  const y = Math.floor(months / 12);
  const m = months % 12;
  return [y ? `${y}년` : '', m ? `${m}개월` : ''].filter(Boolean).join(' ');
}

// 총 경력은 각 기간의 합이 아니라 첫 입사부터 마지막 퇴사까지의 구간으로 셉니다.
// 합산하면 이직 월이 중복으로 잡힙니다.
const careerStart = ABOUT.career.length
  ? parseMonth(ABOUT.career[ABOUT.career.length - 1].period.split('-')[0])
  : null;
const careerEnd = ABOUT.career.length ? parseMonth(ABOUT.career[0].period.split('-')[1]) : null;
const totalMonths = careerStart && careerEnd ? diffMonths(careerStart, careerEnd) + 1 : 0;
const totalYears = Math.floor(totalMonths / 12);

const showDrafts = import.meta.env.DEV;
// 케이스 스터디는 posts에 있고, showcase: true 인 글만 작업으로 취급합니다.
const projects = (
  await getCollection('posts', ({ data }) => data.showcase && (showDrafts || !data.draft))
).sort(
  (a, b) => {
    if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
    return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
  },
);

const stats = [
  {
    value: totalYears,
    suffix: '년',
    label: '개발 경력',
    note: careerStart ? `${careerStart.y}년 ${careerStart.m}월 시작 · ${humanizeMonths(totalMonths)}` : '',
  },
  {
    value: ABOUT.career.length,
    suffix: '곳',
    label: '거쳐온 팀',
    note: '플랫폼 · B2B 솔루션',
  },
  {
    value: projects.length,
    suffix: '건',
    label: '케이스 스터디',
    note: '포트폴리오에 정리한 작업',
  },
];

/** '(주)하울링 · 개발팀 엔지니어' → ['(주)하울링', '개발팀 엔지니어'] */
function splitRole(role: string): [string, string] {
  const i = role.indexOf(' · ');
  if (i === -1) return [role, ''];
  return [role.slice(0, i), role.slice(i + 3)];
}

const hasCareer = ABOUT.career.length > 0;
const hasSkills = ABOUT.skills.primary.length + ABOUT.skills.side.length > 0;
const hasWork = projects.length > 0;
const hasCerts =
  ABOUT.certs.have.length + ABOUT.certs.pursuing.length + ABOUT.certs.education.length > 0;
const hasNow = ABOUT.now.length > 0;

const sections = [
  { id: 'bio', label: '소개', show: ABOUT.bio.length > 0 },
  { id: 'career', label: '경력', show: hasCareer },
  { id: 'skills', label: '기술', show: hasSkills },
  { id: 'work', label: '작업', show: hasWork },
  { id: 'education', label: '자격 · 교육', show: hasCerts },
  { id: 'contact', label: '연락', show: true },
].filter((s) => s.show);

const bold = (s: string) => s.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
---

<Base title="About" description={ABOUT.tagline}>
  <article class="about" data-about>
    <!-- ===== Hero ===== -->
    <header class="hero">
      <div class="hero-glow" aria-hidden="true"></div>
      <div class="reading hero-inner">
        <p class="eyebrow" style="--d: 0ms">
          <span class="dot" aria-hidden="true"></span>
          About
        </p>

        <h1 class="name" style="--d: 60ms">
          {ABOUT.name}
          <span class="handle">/ {ABOUT.handle}</span>
        </h1>

        <p class="tagline" style="--d: 140ms" set:html={bold(ABOUT.tagline)}></p>

        <div class="chips" style="--d: 220ms">
          {ABOUT.location && <span class="chip">📍 {ABOUT.location}</span>}
          <a class="chip link" href={SOCIAL_LINKS.email}>✉ Email</a>
          <a class="chip link" href={SOCIAL_LINKS.github} target="_blank" rel="noreferrer">
            GitHub ↗
          </a>
        </div>

        <dl class="stats" style="--d: 300ms">
          {stats.map((s) => (
            <div class="stat">
              <dt class="stat-label">{s.label}</dt>
              <dd class="stat-value">
                <span data-count={s.value}>0</span><span class="suffix">{s.suffix}</span>
              </dd>
              {s.note && <p class="stat-note">{s.note}</p>}
            </div>
          ))}
        </dl>
      </div>
    </header>

    <!-- ===== Section nav (scrollspy) ===== -->
    <nav class="subnav" aria-label="섹션 바로가기">
      <div class="subnav-inner glass">
        {sections.map((s) => (
          <a href={`#${s.id}`} class="subnav-link" data-spy-link={s.id}>{s.label}</a>
        ))}
      </div>
    </nav>

    <!-- ===== Bio ===== -->
    {ABOUT.bio.length > 0 && (
      <section id="bio" class="section reading" data-spy>
        <h2 class="section-title reveal">소개</h2>
        {ABOUT.bio.map((p, i) => (
          <p class="bio reveal" style={`transition-delay: ${i * 60}ms`} set:html={bold(p)}></p>
        ))}
      </section>
    )}

    <!-- ===== Career ===== -->
    {hasCareer && (
      <section id="career" class="section reading" data-spy>
        <h2 class="section-title reveal">경력</h2>

        <div class="timeline" data-timeline>
          <span class="rail" aria-hidden="true"><span class="rail-fill"></span></span>

          <ol class="entries">
          {ABOUT.career.map((c, i) => {
            const [company, title] = splitRole(c.role);
            const duration = humanizeMonths(monthsOf(c.period));
            return (
              <li class="entry reveal" style={`transition-delay: ${i * 90}ms`}>
                <span class="node" aria-hidden="true"></span>

                <div class="entry-head">
                  <span class="period">{c.period}</span>
                  {duration && <span class="duration">{duration}</span>}
                </div>

                <div class="entry-card surface surface-hover">
                  <p class="company">{company}</p>
                  {title && <p class="role">{title}</p>}
                  {c.summary && <p class="summary">{c.summary}</p>}

                  {c.highlights.length > 0 && (
                    <ul class="highlights">
                      {c.highlights.map((h, j) => (
                        <li style={`--d: ${j * 45}ms`} set:html={h}></li>
                      ))}
                    </ul>
                  )}

                  {c.ongoing && c.ongoing.length > 0 && (
                    <div class="ongoing">
                      <p class="ongoing-label">운영 · 유지보수</p>
                      <ul class="ongoing-list">
                        {c.ongoing.map((o) => <li>{o}</li>)}
                      </ul>
                    </div>
                  )}

                  {c.stack && c.stack.length > 0 && (
                    <ul class="stack">
                      {c.stack.map((s) => <li class="tag">{s}</li>)}
                    </ul>
                  )}
                </div>
              </li>
            );
          })}
          </ol>
        </div>
      </section>
    )}

    <!-- ===== Skills ===== -->
    {hasSkills && (
      <section id="skills" class="section reading" data-spy>
        <h2 class="section-title reveal">기술</h2>

        {ABOUT.skills.primary.length > 0 && (
          <div class="skill-group">
            <h3 class="skill-label reveal">주력</h3>
            <ul class="chip-row">
              {ABOUT.skills.primary.map((s, i) => (
                <li class="chip strong reveal" style={`transition-delay: ${i * 45}ms`}>{s}</li>
              ))}
            </ul>
          </div>
        )}

        {ABOUT.skills.side.length > 0 && (
          <div class="skill-group">
            <h3 class="skill-label reveal">사이드 · 관심</h3>
            <ul class="chip-row">
              {ABOUT.skills.side.map((s, i) => (
                <li class="chip muted reveal" style={`transition-delay: ${i * 35}ms`}>{s}</li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    <!-- ===== Work ===== -->
    {hasWork && (
      <section id="work" class="section reading" data-spy>
        <div class="section-head">
          <h2 class="section-title reveal">작업</h2>
          <a href="/portfolio" class="see-all reveal">전체 보기 →</a>
        </div>

        <ul class="work-list">
          {projects.slice(0, 4).map((p, i) => (
            <li class="reveal" style={`transition-delay: ${i * 70}ms`}>
              <a class="work-item" href={`/posts/${p.id}/`}>
                <span class="work-period">{p.data.period}</span>
                <span class="work-body">
                  <span class="work-title">{p.data.title}</span>
                  <span class="work-desc">{p.data.description}</span>
                </span>
                <span class="work-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    <!-- ===== Certs · Education ===== -->
    {hasCerts && (
      <section id="education" class="section reading" data-spy>
        <h2 class="section-title reveal">자격증 · 교육</h2>

        {ABOUT.certs.have.length > 0 && (
          <div class="cert-group">
            <h3 class="cert-label reveal">보유</h3>
            <ul class="cert-list">
              {ABOUT.certs.have.map((c, i) => (
                <li class="reveal" style={`transition-delay: ${i * 50}ms`}>{c}</li>
              ))}
            </ul>
          </div>
        )}

        {ABOUT.certs.pursuing.length > 0 && (
          <div class="cert-group">
            <h3 class="cert-label reveal">준비 중</h3>
            <ul class="cert-list">
              {ABOUT.certs.pursuing.map((c, i) => (
                <li class="reveal" style={`transition-delay: ${i * 50}ms`}>{c}</li>
              ))}
            </ul>
          </div>
        )}

        {ABOUT.certs.education.length > 0 && (
          <div class="cert-group">
            <h3 class="cert-label reveal">교육</h3>
            <ul class="cert-list">
              {ABOUT.certs.education.map((c, i) => (
                <li class="reveal" style={`transition-delay: ${i * 50}ms`}>{c}</li>
              ))}
            </ul>
          </div>
        )}
      </section>
    )}

    <!-- ===== Now ===== -->
    {hasNow && (
      <section class="section reading">
        <h2 class="section-title reveal">지금</h2>
        <div class="surface now-card reveal">
          {ABOUT.now.map((p) => <p>{p}</p>)}
        </div>
      </section>
    )}

    <!-- ===== Contact ===== -->
    <section id="contact" class="section reading contact-section" data-spy>
      <h2 class="section-title reveal">연락</h2>
      <ul class="contact">
        <li class="reveal">
          <a href={SOCIAL_LINKS.email}>✉ {SOCIAL_LINKS.email.replace('mailto:', '')}</a>
        </li>
        <li class="reveal" style="transition-delay: 60ms">
          <a href={SOCIAL_LINKS.github} target="_blank" rel="noreferrer">
            ↗ {SOCIAL_LINKS.github.replace('https://', '')}
          </a>
        </li>
        <li class="reveal" style="transition-delay: 120ms">
          <a href={SOCIAL_LINKS.rss}>RSS 피드</a>
        </li>
      </ul>
    </section>
  </article>
</Base>

<style>
  .about { padding: 0 0 1rem; }

  .reading {
    width: 100%;
    max-width: var(--reading-width);
    margin-inline: auto;
    padding-inline: 1.5rem;
  }

  /* ===== Entrance animation (hero only, no scroll needed) ===== */
  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .eyebrow,
  .name,
  .tagline,
  .chips,
  .stats {
    opacity: 0;
    animation: rise 0.7s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
    animation-delay: var(--d, 0ms);
  }

  /* ===== Hero ===== */
  .hero {
    position: relative;
    padding: 4.5rem 0 2.5rem;
    isolation: isolate;
  }
  .hero-glow {
    position: absolute;
    top: -6rem;
    left: 0;
    right: 0;
    height: 32rem;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(32% 46% at 22% 45%, color-mix(in oklch, var(--color-accent) 24%, transparent) 0%, transparent 80%),
      radial-gradient(32% 46% at 70% 40%, color-mix(in oklch, oklch(60% 0.2 200) 20%, transparent) 0%, transparent 80%);
    filter: blur(80px);
    animation: drift 20s ease-in-out infinite;
  }
  @keyframes drift {
    0%, 100% { transform: translate(0, 0) scale(1); opacity: 0.95; }
    33% { transform: translate(-3%, 1.5%) scale(1.06); opacity: 1; }
    66% { transform: translate(2.5%, -1%) scale(1.03); opacity: 0.88; }
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin: 0 0 1rem;
    padding: 0.25rem 0.8rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-1);
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--color-muted);
    text-transform: uppercase;
  }
  .eyebrow .dot {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 9999px;
    background: oklch(72% 0.18 145);
    box-shadow: 0 0 0 3px color-mix(in oklch, oklch(72% 0.18 145) 25%, transparent);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.35; }
  }

  .name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.25rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin: 0 0 0.65rem;
  }
  .name .handle {
    font-size: 0.42em;
    font-weight: 400;
    color: var(--color-muted);
    letter-spacing: -0.01em;
    margin-left: 0.4rem;
    vertical-align: 0.35em;
  }

  .tagline {
    margin: 0 0 1.5rem;
    max-width: 34rem;
    font-size: 1.1rem;
    line-height: 1.65;
    color: var(--color-muted);
  }
  .tagline :global(strong) { color: var(--color-fg); }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface-subtle);
    border: 1px solid var(--color-border);
    font-size: 0.85rem;
    color: var(--color-muted);
  }
  .chip.link {
    color: var(--color-fg);
    text-decoration: none;
    transition: border-color 0.2s, color 0.2s, transform 0.2s;
  }
  .chip.link:hover {
    border-color: var(--color-border-strong);
    color: var(--color-accent);
    transform: translateY(-1px);
  }

  /* Stats */
  .stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 2.25rem 0 0;
  }
  .stat {
    padding: 1rem 1.1rem 1.1rem;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-1);
    transition: border-color 0.25s, transform 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  .stat:hover {
    border-color: color-mix(in oklch, var(--color-accent) 30%, var(--color-border-strong));
    transform: translateY(-2px);
  }
  .stat-label {
